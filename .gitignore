*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# Wyjście kompilatora Klin — wyłącznie do out/
/out/

# Cache go-task (checksumy sources/generates)
.task/

# Narzędzia / IDE / system
.idea/
*.iml
.vscode/
.DS_Store
