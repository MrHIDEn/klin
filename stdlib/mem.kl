/// Optional host heap allocator (libc malloc/free).
/// Do not import on freestanding / bare-metal without a heap.
module mem

/// Placeholder for future vtable / arena; heap MVP ignores fields.
pub struct Allocator {
    _pad: u8
}

@[cimport, codename("klin_mem_alloc_u8")]
fn host_alloc_u8(n: i32): ![]u8

@[cimport, codename("klin_mem_free_u8")]
fn host_free_u8(buf: []u8)

@[cimport, codename("klin_mem_alloc_i32")]
fn host_alloc_i32(n: i32): ![]i32

@[cimport, codename("klin_mem_free_i32")]
fn host_free_i32(buf: []i32)

pub fn heap(): Allocator {
    return Allocator{ _pad: 0 }
}

pub fn (mut a: Allocator) alloc_bytes(n: i32): ![]u8 {
    return host_alloc_u8(n)
}

pub fn (mut a: Allocator) free_bytes(buf: []u8) {
    host_free_u8(buf)
}

pub fn alloc_u8(a: *mut Allocator, n: i32): ![]u8 {
    return host_alloc_u8(n)
}

pub fn free_u8(a: *mut Allocator, buf: []u8) {
    host_free_u8(buf)
}

pub fn alloc_i32(a: *mut Allocator, n: i32): ![]i32 {
    return host_alloc_i32(n)
}

pub fn free_i32(a: *mut Allocator, buf: []i32) {
    host_free_i32(buf)
}
