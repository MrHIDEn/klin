// Allocating slice helpers — explicit Allocator + defer free (issue 017 layer 2).
import mem
import slice_alloc

fn times2(x: i32): i32 {
    return x + x
}

fn is_pos(x: i32): bool {
    return x > 0
}

fn main() {
    let mut a = mem.heap()
    let xs: [4]i32 = [1, 0 - 2, 3, 0]

    let mut mapped = slice_alloc.map_alloc_i32(&a, xs[:], times2) or {
        mem.empty_i32()
    }
    defer mem.free_i32(&a, mapped)
    printf("%d %d %d %d\n", mapped[0], mapped[1], mapped[2], mapped[3])

    let mut filtered = slice_alloc.filter_alloc_i32(&a, xs[:], is_pos) or {
        mem.empty_i32()
    }
    defer mem.free_i32(&a, filtered)
    printf("%d %d\n", filtered[0], filtered[1])
}
