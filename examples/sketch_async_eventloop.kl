/// Runnable with Klin async/await + eventloop v0.2 (issue 029 phase 4).
/// Local package: `dart run bin/klin.dart run examples/pkg_eventloop/async_app.kl`
/// Remote (after publish): `klin get github/mrhiden/eventloop@v0.2.0` then
/// `klin run` this file (uses the same API).
///
/// Model: Rust-like state machine + explicit executor. No JS Promise/GC.

import "github/mrhiden/eventloop"
import io

async fn delay_ms(ms: i64) {
    eventloop.sleep_ms(ms).await
}

async fn ticker() {
    let mut n: i32 = 0
    while n < 3 {
        io.println("tick")
        n = n + 1
        delay_ms(50).await
    }
}

fn main() {
    let mut ex: eventloop.Executor
    let init_rc = eventloop.init(&ex) or { 1 }
    if init_rc != 0 {
        io.println("init failed")
        return
    }
    let spawn_rc = eventloop.spawn(&ex, ticker) or {
        io.println("spawn failed")
        0 - 1
    }
    if spawn_rc < 0 {
        return
    }
    eventloop.run(&ex)
    printf("ticks done version=%d\n", eventloop.version())
}
