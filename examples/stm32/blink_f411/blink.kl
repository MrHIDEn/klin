@[cinclude("stm32f411_regs.h")]
@[codename("SysTick_Handler")]
fn systick_handler() {
  GPIOA_ODR_ODR5_toggle()
}

fn main() {
  RCC_AHB1ENR_GPIOAEN_set(1)
  GPIOA_MODER_MODER5_write(1) // Output
  STK_RVR_RELOAD_write(7_999_999)
  STK_CVR_CURRENT_write(0)
  STK_CSR_ENABLE_set(1)
  STK_CSR_TICKINT_set(1)
  STK_CSR_CLKSOURCE_set(1)
  while true {
    asm("wfi")
  }
}
