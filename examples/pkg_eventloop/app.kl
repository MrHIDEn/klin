/// Callback ticker (v0.1 API — still supported in v0.2).
import eventloop
import io

struct App {
    ticks: i32
    ex: *mut u8
}

fn on_tick(ctx: *mut u8) {
    let app = cast(*mut App, ctx)
    (*app).ticks = (*app).ticks + 1
    io.println("tick")
    if (*app).ticks >= 3 {
        eventloop.stop(cast(*mut eventloop.Executor, (*app).ex))
    }
}

fn main() {
    let mut ex: eventloop.Executor
    let mut app = App{ ticks: 0, ex: cast(*mut u8, &ex) }
    let init_rc = eventloop.init(&ex) or { 1 }
    if init_rc != 0 {
        io.println("init failed")
        return
    }
    let arm_rc = eventloop.every_ms(&ex, 50, on_tick, cast(*mut u8, &app)) or {
        io.println("every_ms failed")
        0
    }
    if arm_rc == 0 {
        return
    }
    eventloop.run(&ex)
    printf("ticks=%d version=%d\n", app.ticks, eventloop.version())
}
