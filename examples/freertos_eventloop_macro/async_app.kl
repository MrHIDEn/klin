/// FreeRTOS + `$rtos_task` + `$event_loop` async/await (issue 029).
/// Manual init/run variant: [`../freertos_eventloop_async/app.kl`](../freertos_eventloop_async/app.kl)
/// Prerequisites: klin get github/klin-lang/klin_freertos@v0.2.0
///                klin get github/klin-lang/eventloop@v0.3.0
/// Emit-c / expand against FreeRTOS headers (stubs OK). Not a host `klin run` demo.
import "github/klin-lang/klin_freertos" freertos
import "github/klin-lang/eventloop"
import io

async fn delay_ms(ms: i64) {
    eventloop.sleep_ms(ms).await
}

async fn ticker() {
    let mut n: i32 = 0
    while n < 3 {
        io.println("async tick")
        n = n + 1
        delay_ms(50).await
    }
}

$rtos_task(net, 1024, 3) {
    $event_loop(ex) {
        let spawn_rc = eventloop.spawn(&ex, ticker) or {
            0 - 1
        }
        if spawn_rc < 0 {
            return
        }
    }
}

$rtos_task(idle_work, 512, 2) {
    while true {
        freertos.task_delay(100)
    }
}

fn main() {
    start_net()
    start_idle_work()
    freertos.task_start_scheduler()
}
