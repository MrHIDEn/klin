/// Async ticker via compiler desugar + eventloop spawn/sleep_ms (issue 029).
import "github/klin-lang/eventloop"
import io

async fn delay_ms(ms: i64) {
    eventloop.sleep_ms(ms).await
}

async fn ticker() {
    let mut n: i32 = 0
    while n < 3 {
        io.println("tick")
        n = n + 1
        delay_ms(50).await
    }
}

fn main() {
    let mut ex: eventloop.Executor
    let init_rc = eventloop.init(&ex) or { 1 }
    if init_rc != 0 {
        io.println("init failed")
        return
    }
    let spawn_rc = eventloop.spawn(&ex, ticker) or {
        io.println("spawn failed")
        0 - 1
    }
    if spawn_rc < 0 {
        return
    }
    eventloop.run(&ex)
    printf("ticks done version=%d\n", eventloop.version())
}
