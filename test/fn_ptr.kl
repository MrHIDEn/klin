fn is_pos(x: i32): bool {
    return x > 0
}

fn count_pos(xs: []i32, pred: fn(i32): bool): i32 {
    let mut n: i32 = 0
    let mut i: i32 = 0
    while i < xs.len {
        if pred(xs[i]) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn main() {
    let xs: [4]i32 = [1, 0 - 2, 3, 0]
    let n = count_pos(xs[:], is_pos)
    printf("n=%d\n", n)

    let mut pred: fn(i32): bool = is_pos
    let n2 = count_pos(xs[:], pred)
    printf("n2=%d\n", n2)
}
