// Issue 064: condition ending in a bare name must not eat `{` as struct lit.
// Parentheses remain optional.

fn clamp(v: i32, lo: i32, hi: i32): i32 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn main() {
    printf("%d\n", clamp(10, 0, 5))
    printf("%d\n", clamp(-3, 0, 5))
    let mut a = 1
    let b = 2
    if a < b {
        printf("less\n")
    }
    if (a < b) {
        printf("paren\n")
    }
    while a < b {
        a = a + 1
    }
    printf("%d\n", a)
    let mut c = 0
    while (c < b) {
        c = c + 1
    }
    printf("%d\n", c)
    for i in 0..<b {
        printf("%d\n", i)
    }
}
