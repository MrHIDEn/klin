import slice

fn times2(x: i32): i32 {
    return x * 2
}

fn is_pos(x: i32): bool {
    return x > 0
}

fn add(a: i32, b: i32): i32 {
    return a + b
}

fn main() {
    let xs: [4]i32 = [1, 0 - 2, 3, 0]
    let mut out: [4]i32 = [0, 0, 0, 0]
    let _ = slice.map_into_i32(xs[:], out[:], times2) or {
        printf("map_fail\n")
        0
    }
    printf("map=%d,%d,%d,%d\n", out[0], out[1], out[2], out[3])

    let mut filt: [4]i32 = [0, 0, 0, 0]
    let n = slice.filter_into_i32(xs[:], filt[:], is_pos) or {
        printf("filter_fail\n")
        0
    }
    printf("n=%d f0=%d f1=%d\n", n, filt[0], filt[1])

    printf("idx=%d\n", slice.index_of_i32(xs[:], is_pos))
    printf("any=%d\n", slice.any_i32(xs[:], is_pos))
    printf("count=%d\n", slice.count_i32(xs[:], is_pos))
    printf("reduce=%d\n", slice.reduce_i32(xs[:], 0, add))

    // General ops (issue 017 rozszerzenie).
    let mut cp: [4]i32 = [0, 0, 0, 0]
    let cn = slice.copy_into_i32(xs[:], cp[:]) or { 0 - 1 }
    printf("copy=%d,%d,%d,%d (n=%d)\n", cp[0], cp[1], cp[2], cp[3], cn)
    let mut rv: [4]i32 = [0, 0, 0, 0]
    let rn = slice.reverse_into_i32(xs[:], rv[:]) or { 0 - 1 }
    printf("rev=%d,%d,%d,%d (n=%d)\n", rv[0], rv[1], rv[2], rv[3], rn)

    // Numeric ops (i32).
    printf("sum=%d product=%d\n", slice.sum_i32(xs[:]), slice.product_i32(xs[:]))
    let mn = slice.min_i32(xs[:]) or { 0 }
    let mx = slice.max_i32(xs[:]) or { 0 }
    printf("min=%d max=%d\n", mn, mx)
    printf("has3=%d has9=%d\n", slice.contains_i32(xs[:], 3), slice.contains_i32(xs[:], 9))

    // i64 instances (array built via mut + element writes).
    let mut xl: [3]i64
    xl[0] = 5
    xl[1] = 2
    xl[2] = 8
    printf("i64 sum=%lld product=%lld\n", slice.sum_i64(xl[:]), slice.product_i64(xl[:]))
    let lmn = slice.min_i64(xl[:]) or { 0 }
    printf("i64 min=%lld\n", lmn)

    // f64 instances (float literals default to f64).
    let xf: [3]f64 = [1.5, 2.0, 0.5]
    printf("f64 sum=%g\n", slice.sum_f64(xf[:]))
    let fmx = slice.max_f64(xf[:]) or { 0.0 }
    printf("f64 max=%g\n", fmx)
}
