struct P {
    x: i32
    y: i32
}

fn main() {
    // Swap two variables without a temp in source.
    let mut a: i32 = 1
    let mut b: i32 = 2
    a, b = b, a
    printf("swap: %d %d\n", a, b)

    // Swap struct fields.
    let mut p = P{ x: 10, y: 20 }
    p.x, p.y = p.y, p.x
    printf("fields: %d %d\n", p.x, p.y)

    // Swap array elements.
    let mut xs: [3]i32 = [1, 2, 3]
    xs[0], xs[2] = xs[2], xs[0]
    printf("arr: %d %d %d\n", xs[0], xs[1], xs[2])

    // Three-way rotation.
    let mut c: i32 = 5
    let mut d: i32 = 6
    let mut e: i32 = 7
    c, d, e = e, c, d
    printf("rot: %d %d %d\n", c, d, e)
}
