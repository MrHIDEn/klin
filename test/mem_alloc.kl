import mem
import io

fn main() {
    let mut a = mem.heap()

    let mut buf = a.alloc_bytes(4) or {
        io.println("alloc_bytes_fail")
        mem.empty_u8()
    }
    defer a.free_bytes(buf)
    buf[0] = 10
    buf[1] = 20
    buf[2] = 30
    buf[3] = 40
    printf("bytes=%d\n", buf[0] + buf[1] + buf[2] + buf[3])

    let mut empty = a.alloc_bytes(0) or {
        io.println("empty_fail")
        mem.empty_u8()
    }
    defer a.free_bytes(empty)
    printf("empty_len=%d\n", empty.len)

    let _neg = a.alloc_bytes(0 - 1) or {
        printf("neg_err=%d\n", err)
        mem.empty_u8()
    }

    let mut xs = mem.alloc_i32(&a, 3) or {
        io.println("alloc_i32_fail")
        mem.empty_i32()
    }
    defer mem.free_i32(&a, xs)
    xs[0] = 1
    xs[1] = 2
    xs[2] = 3
    printf("i32=%d\n", xs[0] + xs[1] + xs[2])

    let mut xl = mem.alloc_i64(&a, 3) or {
        io.println("alloc_i64_fail")
        mem.empty_i64()
    }
    defer mem.free_i64(&a, xl)
    xl[0] = 100
    xl[1] = 200
    xl[2] = 300
    printf("i64=%lld\n", xl[0] + xl[1] + xl[2])

    let mut xf = mem.alloc_f64(&a, 2) or {
        io.println("alloc_f64_fail")
        mem.empty_f64()
    }
    defer mem.free_f64(&a, xf)
    xf[0] = 1.5
    xf[1] = 2.5
    printf("f64=%g\n", xf[0] + xf[1])
}
