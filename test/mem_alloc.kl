        scratch[:]
    }

    let mut zi: [1]i32
    let mut xs = mem.alloc_i32(&a, 3) or {
        io.println("alloc_i32_fail")
        zi[:]
    }
    defer mem.free_i32(&a, xs)
    xs[0] = 1
    xs[1] = 2
    xs[2] = 3
    printf("i32=%d\n", xs[0] + xs[1] + xs[2])
