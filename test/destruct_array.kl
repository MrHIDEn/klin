fn main() {
    let xs: [3]i32 = [10, 20, 30]

    let [a, b, c] = xs
    printf("var: %d %d %d\n", a, b, c)

    let [p, q] = [7, 8]
    printf("lit: %d %d\n", p, q)

    {
        let mut [m, n, o] = xs
        m = m + 100
        printf("mut: %d %d %d\n", m, n, o)
    }

    // Swap via an array-literal source (shadows outer p, q in a block):
    // must read the outer values, not the freshly declared bindings.
    {
        let [p, q] = [q, p]
        printf("swap: %d %d\n", p, q)
    }

    // A binding that shadows the source array name (in a block).
    {
        let [xs, y, z] = xs
        printf("shadow: %d %d %d\n", xs, y, z)
    }
}
