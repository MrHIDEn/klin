pub struct Vec2 {
    x: i32
    y: i32
}

pub fn (v: Vec2) len_sq(): i32 {
    return v.x * v.x + v.y * v.y
}

pub fn (mut v: Vec2) translate(dx: i32, dy: i32) {
    v.x = v.x + dx
    v.y = v.y + dy
}

fn main() {
    let mut p = Vec2{ x: 3, y: 4 }
    let q = Vec2{ 1, 2 }
    printf("%d\n", p.len_sq())
    p.translate(1, 1)
    printf("%d\n", p.x)
    printf("%d\n", p.y)
}
