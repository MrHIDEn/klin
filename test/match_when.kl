fn main() {
    let flag = 1
    match 2 {
        1, 2 when flag != 0 {
            puts("guarded")
        }
        1, 2 {
            puts("plain")
        }
        else {
            puts("other")
        }
    }

    match 2 {
        1, 2 when flag == 0 {
            puts("no")
        }
        1, 2 {
            puts("plain2")
        }
        else {
            puts("other2")
        }
    }

    let mut n = 0
    for i in 0..<6 {
        match i {
            0..=4 when (i & 1) == 0 {
                n = n + 1
            }
            _ when i == 5 {
                n = n + 100
            }
            else {
            }
        }
    }
    printf("%d\n", n)

    let fee = match 3 {
        1, 2 when flag != 0 { 1 }
        3 when flag != 0 { 2 }
        else { 3 }
    }
    printf("%d\n", fee)
}
